# Container image for clopy-paste, generated by the go-http-service ignition pack (phase ops).
# The build stage is offline: modules come from vendor/ (run `go mod vendor` before building),
# GOPROXY=off, and the go build step runs with --network=none (BuildKit or buildah).
# The runtime runs as a numeric non-root USER with group-0 ownership, so an arbitrary UID
# in group 0 (e.g. OpenShift restricted-v2) can run it on a read-only root filesystem.
# Override the images with --build-arg, or with the builder_image / runtime_image init answers.
ARG BUILDER_IMAGE=golang:1.27
ARG RUNTIME_IMAGE=registry.access.redhat.com/ubi9/ubi-micro

FROM ${BUILDER_IMAGE} AS build
ARG VERSION=dev
WORKDIR /src
ENV CGO_ENABLED=0 GOFLAGS=-mod=vendor GOPROXY=off GOTOOLCHAIN=local
COPY . .
RUN --network=none --mount=type=cache,target=/root/.cache/go-build go build -mod=vendor -trimpath -ldflags "-s -w -X main.version=${VERSION}" -o /out/clopy-paste ./cmd/clopy-paste \
    && chmod 0555 /out/clopy-paste

FROM ${RUNTIME_IMAGE}
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build --chown=1001:0 /out/clopy-paste /usr/local/bin/clopy-paste
USER 1001
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/clopy-paste"]
