  "524": "ADR-001: Per-instance input/output topics, external pipeline links them",
  "525": "ADR-002: Go for the server",
  "526": "ADR-003: UI refreshes received messages by polling",
  "527": "ADR-004: In-memory message store, single replica",
  "528": "ADR-005: Configurable character denylist, applied to username and text",
  "529": "ADR-006: Reject over-limit input; drop and log invalid incoming records",
  "530": "ADR-007: Kafka record contract",
  "531": "ADR-008: Kafka connection — SASL_SSL/SCRAM-SHA-512 in prod, plaintext for dev",
  "532": "ADR-009: Local and CI environment — kind + Strimzi",
  "533": "ADR-010: CI/CD logic in Makefile + scripts, thin GitHub/GitLab wrappers",
  "534": "ADR-011: Pipeline stages, environments, versioning",
  "535": "ADR-012: JSON logs to stdout; Filebeat sidecar deferred",
  "536": "ADR-013: Store holds received messages only; LRU touched by receive and view",
  "537": "ADR-014: No application-level authentication; network-restricted exposure",
  "538": "ADR-015: Locked tech stack",
  "539": "ADR-016: Readiness independent of Kafka",
  "540": "ADR-017: Consumer group, offset reset and operational defaults",
