{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Edit(*)",
      "Write(*)",
      "Grep(*)",
      "Glob(*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/yoava/AppData/Roaming/uv/tools/ydk/Scripts/python.exe C:/Users/yoava/Projects/clopy-paste/.claude/hooks/guard.py"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-task-complete.sh"
          }
        ]
      }
    ]
  }
}